# ProofLedger AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real secrets to Git.

# ── PayPal Sandbox Credentials ──────────────────────────────────────────────
# Obtain from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox
# To use live mode (danger), also set:
# PAYPAL_LIVE_CONFIRM=yes_i_understand_this_is_live
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ── Model Configuration ───────────────────────────────────────────────────
# Local path to fine-tuned model, or HF model ID for pretrained baseline
MODEL_PATH=artifacts/best_model
MODEL_VERSION=finetuned_v1.0
DATASET_VERSION=evidencebench_v1.0

# ── API Configuration ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Hugging Face (optional, for private models) ───────────────────────────
# HUGGINGFACE_TOKEN=your_hf_token_here

